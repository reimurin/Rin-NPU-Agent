<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Rin.PageTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/rin_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Rin.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/rin_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Rin.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/rin_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Rin.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/rin_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Rin.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/rin_button_primary</item>
        <item name="android:textColor">@color/rin_on_primary</item>
        <item name="iconTint">@color/rin_on_primary</item>
    </style>

    <style name="Widget.Rin.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/rin_button_secondary</item>
        <item name="android:textColor">@color/rin_text_primary</item>
        <item name="iconTint">@color/rin_text_primary</item>
    </style>

    <style name="Widget.Rin.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/rin_text_secondary</item>
        <item name="iconTint">@color/rin_text_secondary</item>
    </style>

    <style name="Widget.Rin.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/rin_danger_soft</item>
        <item name="android:textColor">@color/rin_danger</item>
    </style>

    <style name="Widget.Rin.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/rin_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rin_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Rin.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/rin_surface_soft</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Rin.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/rin_surface_soft</item>
        <item name="boxStrokeColor">@color/rin_textinput_stroke</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/rin_text_secondary</item>
        <item name="android:textColorHint">@color/rin_text_secondary</item>
    </style>

    <style name="Widget.Rin.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">5dp</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="indicatorColor">@color/rin_primary</item>
        <item name="trackColor">@color/rin_surface_soft</item>
    </style>
    <style name="ThemeOverlay.Rin.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/rin_primary</item>
        <item name="colorSurface">@color/rin_surface</item>
        <item name="colorOnSurface">@color/rin_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/rin_text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Rin.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Rin.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Rin.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Rin.Dialog.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Rin.Dialog.Ghost</item>
    </style>
    <style name="Widget.Rin.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Rin.PageTitle</item>
        <item name="android:textColor">@color/rin_text_primary</item>
    </style>
    <style name="Widget.Rin.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Rin.Body</item>
        <item name="android:textColor">@color/rin_text_secondary</item>
    </style>
    <style name="Widget.Rin.Dialog.Positive" parent="Widget.Rin.Button.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Widget.Rin.Dialog.Ghost" parent="Widget.Rin.Button.Ghost">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>

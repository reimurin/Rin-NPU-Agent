package com.geniex.demo.agent

import com.geniex.demo.artifact.PptxBuilder
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive

class AgentToolExecutor(private val workspace: ProjectWorkspace) {
    val definitions: String = """[
      {"type":"function","function":{"name":"list_directory","description":"List files and folders inside the already-authorized Android project workspace. Use an empty path for the project root.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Relative path inside the authorized project root"}},"required":[]}}},
      {"type":"function","function":{"name":"read_file","description":"Read a UTF-8 text/code file inside the already-authorized Android project workspace.","parameters":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}}},
      {"type":"function","function":{"name":"create_directory","description":"Create a directory, including missing parents, inside the already-authorized Android project workspace.","parameters":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}}},
      {"type":"function","function":{"name":"write_file","description":"Create or fully replace a TEXT/code file inside the already-authorized Android project workspace. Do not use for pptx/docx/xlsx/pdf/zip.","parameters":{"type":"object","properties":{"path":{"type":"string"},"content":{"type":"string"}},"required":["path","content"]}}},
      {"type":"function","function":{"name":"create_presentation","description":"Create a real PowerPoint .pptx file inside the authorized project workspace. Use this instead of write_file for PPTX.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Relative .pptx path, e.g. A镜头/汇报.pptx"},"title":{"type":"string"},"slides":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"bullets":{"type":"array","items":{"type":"string"}}},"required":["title"]}}},"required":["path","slides"]}}}
    ]"""

    fun execute(name: String, argumentsJson: String): String = runCatching {
        require(name in ALLOWED_TOOLS) { "Unknown tool: $name" }
        val args = Json.parseToJsonElement(argumentsJson).jsonObject
        when (name) {
            "list_directory" -> workspace.list(args.string("path", ""))
            "read_file" -> workspace.readText(args.string("path"))
            "create_directory" -> workspace.createDirectory(args.string("path"))
            "write_file" -> {
                val content = args.string("content")
                require(content.length <= MAX_TEXT_WRITE_CHARS) { "Text write is too large" }
                workspace.writeText(args.string("path"), content)
            }
            "create_presentation" -> {
                val path = args.string("path")
                require(path.lowercase().endsWith(".pptx")) { "Presentation path must end with .pptx" }
                val title = args.string("title", "Presentation")
                val slideArray = args["slides"] as? JsonArray ?: error("Missing slides array")
                val slides = slideArray.take(MAX_PRESENTATION_SLIDES).map { element ->
                    val obj = element.jsonObject
                    val slideTitle = obj.string("title")
                    val bullets = (obj["bullets"] as? JsonArray)?.map { it.jsonPrimitive.content } ?: emptyList()
                    PptxBuilder.Slide(slideTitle, bullets)
                }
                val bytes = PptxBuilder.build(title, slides)
                workspace.writeBytes(path, bytes, PPTX_MIME)
            }
            else -> error("Unknown tool: $name")
        }
    }.fold(onSuccess = { it }, onFailure = { "Tool error: ${it.message}" })

    private fun JsonObject.string(key: String, default: String? = null): String =
        this[key]?.jsonPrimitive?.content ?: default ?: error("Missing argument: $key")

    companion object {
        val ALLOWED_TOOLS = setOf("list_directory", "read_file", "create_directory", "write_file", "create_presentation")
        private const val MAX_TEXT_WRITE_CHARS = 1_000_000
        private const val MAX_PRESENTATION_SLIDES = 60
        private const val PPTX_MIME = "application/vnd.openxmlformats-officedocument.presentationml.presentation"
    }
}

data class ParsedToolCall(val name: String, val arguments: String)

object AgentToolParser {
    private val qwenTag = Regex("<tool_call>\\s*(.*?)\\s*</tool_call>", setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.IGNORE_CASE))
    private val jsonFence = Regex("```(?:json)?\\s*(\\{.*?})\\s*```", setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.IGNORE_CASE))

    fun parse(text: String): List<ParsedToolCall> {
        if (text.length > MAX_PARSE_CHARS) return emptyList()
        val payloads = mutableListOf<String>()
        payloads += qwenTag.findAll(text).map { it.groupValues[1] }.toList()
        if (payloads.isEmpty()) payloads += jsonFence.findAll(text).map { it.groupValues[1] }.toList()
        if (payloads.isEmpty()) {
            val trimmed = text.trim()
            if ((trimmed.startsWith("{") && trimmed.endsWith("}")) || (trimmed.startsWith("[") && trimmed.endsWith("]"))) {
                payloads += trimmed
            }
        }
        return payloads.flatMap { parsePayload(it) }.distinctBy { it.name + "\u0000" + it.arguments }
    }

    private fun parsePayload(payload: String): List<ParsedToolCall> = runCatching {
        parseElement(Json.parseToJsonElement(payload))
    }.getOrDefault(emptyList())

    private fun parseElement(element: JsonElement): List<ParsedToolCall> {
        return when (element) {
            is JsonArray -> element.flatMap(::parseElement)
            is JsonObject -> {
                val nested = element["tool_calls"]
                if (nested != null) {
                    parseElement(nested)
                } else {
                    val function = element["function"] as? JsonObject
                    val name = (function?.get("name") ?: element["name"])?.jsonPrimitive?.content
                    if (name == null || name !in AgentToolExecutor.ALLOWED_TOOLS) {
                        emptyList()
                    } else {
                        val argsElement = function?.get("arguments") ?: element["arguments"]
                        val args = when (argsElement) {
                            null -> "{}"
                            is JsonObject -> argsElement.toString()
                            else -> argsElement.jsonPrimitive.content
                        }
                        listOf(ParsedToolCall(name, args))
                    }
                }
            }
            else -> emptyList()
        }
    }

    private const val MAX_PARSE_CHARS = 2_000_000
}

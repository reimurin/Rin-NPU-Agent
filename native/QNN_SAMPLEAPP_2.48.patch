+std::string rinJsonQuote(const std::string& text) {
+  std::string out = "\"";
+  const char* hex = "0123456789abcdef";
+  for (unsigned char c : text) {
+    if (c == '"' || c == '\\') { out.push_back('\\'); out.push_back(c); }
+    else if (c < 32) { out += "\\u00"; out.push_back(hex[c >> 4]); out.push_back(hex[c & 15]); }
+    else out.push_back(c);
+  }
+  out.push_back('"');
+  return out;
+}
+uint16_t rinFloatToHalf(float value) {
+  uint32_t bits = 0; std::memcpy(&bits, &value, sizeof(bits));
+  uint32_t sign = (bits >> 16) & 0x8000u, exp = (bits >> 23) & 0xffu, mant = bits & 0x7fffffu;
+  if (exp == 0xffu) return static_cast<uint16_t>(sign | 0x7c00u | (mant ? 0x0200u : 0u));
+  int32_t newExp = static_cast<int32_t>(exp) - 127 + 15;
+  if (newExp >= 31) return static_cast<uint16_t>(sign | 0x7c00u);
+  if (newExp <= 0) {
+    if (newExp < -10) return static_cast<uint16_t>(sign);
+    mant |= 0x800000u; uint32_t shift = static_cast<uint32_t>(14 - newExp), halfMant = mant >> shift;
+    uint32_t roundBit = 1u << (shift - 1u);
+    if ((mant & roundBit) && ((mant & (roundBit - 1u)) || (halfMant & 1u))) ++halfMant;
+    return static_cast<uint16_t>(sign | halfMant);
+  }
+  uint32_t halfExp = static_cast<uint32_t>(newExp) << 10, halfMant = mant >> 13;
+  if ((mant & 0x1000u) && ((mant & 0x0fffu) || (halfMant & 1u))) {
+    ++halfMant; if (halfMant == 0x400u) { halfMant = 0; halfExp += 0x400u; if (halfExp >= 0x7c00u) return static_cast<uint16_t>(sign | 0x7c00u); }
+  }
+  return static_cast<uint16_t>(sign | halfExp | halfMant);
+}
+float rinHalfToFloat(uint16_t value) {
+  uint32_t sign = (static_cast<uint32_t>(value & 0x8000u)) << 16, exp = (value >> 10) & 0x1fu, mant = value & 0x03ffu, bits = 0;
+  if (exp == 0) {
+    if (mant == 0) bits = sign;
+    else { int32_t e = -14; while ((mant & 0x0400u) == 0) { mant <<= 1; --e; } mant &= 0x03ffu; bits = sign | (static_cast<uint32_t>(e + 127) << 23) | (mant << 13); }
+  } else if (exp == 0x1fu) bits = sign | 0x7f800000u | (mant << 13);
+  else bits = sign | ((exp + 112u) << 23) | (mant << 13);
+  float out = 0.0f; std::memcpy(&out, &bits, sizeof(out)); return out;
+}

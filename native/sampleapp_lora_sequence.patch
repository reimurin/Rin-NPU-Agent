+sample_app::StatusCode sample_app::QnnSampleApp::rinApplyAdapter(const std::string& path) {
+  if (!m_context || !m_graphsInfo || m_graphsCount != 1 || !m_qnnFunctionPointers.qnnInterface.contextApplyBinarySection) {
+    m_lastExecutionDetail = "adapter_api_or_context_missing";
+    return StatusCode::FAILURE;
+  }
+  std::ifstream input(path, std::ios::binary | std::ios::ate);
+  const auto size = input ? input.tellg() : std::streampos(-1);
+  if (size <= 0 || size > std::streampos(512ULL * 1024 * 1024)) {
+    m_lastExecutionDetail = "adapter_file_invalid";
+    return StatusCode::FAILURE;
+  }
+  m_rinAdapterBuffers.emplace_back(static_cast<size_t>(size));
+  auto& bytes = m_rinAdapterBuffers.back();
+  input.seekg(0);
+  if (!input.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()))) {
+    m_lastExecutionDetail = "adapter_file_read_failed";
+    return StatusCode::FAILURE;
+  }
+  QnnContext_Buffer_t buffer{};
+  buffer.version = QNN_CONTEXT_BUFFER_VERSION_1;
+  buffer.v1.memType = QNN_CONTEXTMEMTYPE_RAW;
+  buffer.v1.binaryBuf.data = bytes.data();
+  buffer.v1.binaryBuf.dataSize = bytes.size();
+  const auto rc = m_qnnFunctionPointers.qnnInterface.contextApplyBinarySection(
+      m_context, (*m_graphsInfo)[0].graph, QNN_CONTEXT_SECTION_UPDATABLE, &buffer, nullptr, nullptr);
+  QNN_INFO("RIN_LORA_APPLY bytes=%zu code=%llu", bytes.size(), static_cast<unsigned long long>(rc));
+  m_lastExecutionDetail = "adapter_apply code=" + std::to_string(static_cast<unsigned long long>(rc));
+  return rc == QNN_SUCCESS ? StatusCode::SUCCESS : StatusCode::FAILURE;
+}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rin_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="18dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/TextAppearance.Rin.PageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/model_library" />
    <TextView
        android:id="@+id/tv_active_model"
        style="@style/TextAppearance.Rin.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/active_model_none" />
    <TextView
        android:id="@+id/tv_build_mode"
        style="@style/TextAppearance.Rin.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp" />
    <TextView
        style="@style/TextAppearance.Rin.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/model_store_note" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Rin.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView style="@style/TextAppearance.Rin.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quick_model_setup_title" />
            <TextView android:id="@+id/tv_quick_setup_status" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/quick_setup_not_installed" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_quick_install_primary" style="@style/Widget.Rin.Button.Primary" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="@string/install_primary_npu" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_quick_install_vision" style="@style/Widget.Rin.Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:text="@string/install_vision_npu" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/TextAppearance.Rin.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:text="@string/installed_models" />
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Rin.Card.Soft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_models"
                style="@style/Widget.Rin.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="end"
                android:text="@string/refresh" />
            <ListView
                android:id="@+id/list_installed"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:background="@android:color/transparent"
                android:divider="@color/rin_outline"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/rin_bg_mode_selected" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/TextAppearance.Rin.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:text="@string/recommended_models" />
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Rin.Card.Soft"
        android:layout_width="match_parent"
        android:layout_height="132dp">
        <ListView
            android:id="@+id/list_recommended"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:divider="@color/rin_outline"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/rin_bg_mode_selected" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/TextAppearance.Rin.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:text="@string/huggingface_search" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rin.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/huggingface_search_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_model_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/rin_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search_models"
            style="@style/Widget.Rin.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="@string/search" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Rin.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:divider="@color/rin_outline"
            android:dividerHeight="1dp"
            android:listSelector="@drawable/rin_bg_mode_selected" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_download"
        style="@style/Widget.Rin.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_download_status"
        style="@style/TextAppearance.Rin.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textIsSelectable="true" />
</LinearLayout>

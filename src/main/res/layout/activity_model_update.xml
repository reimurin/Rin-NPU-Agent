<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rin_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">
        <ImageButton
            android:id="@+id/btn_update_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/rin_bg_icon_button"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/icon_back"
            app:tint="@color/rin_text_primary" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/TextAppearance.Rin.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型" />
            <TextView
                android:id="@+id/tv_update_app_version"
                style="@style/TextAppearance.Rin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/tv_update_last_check"
                style="@style/TextAppearance.Rin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/model_update_last_check_none" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/model_update_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <TextView style="@style/TextAppearance.Rin.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingBottom="8dp" android:text="基础模型" />
            <TextView
                style="@style/TextAppearance.Rin.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="6dp"
                android:text="@string/model_update_device_section" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Rin.Card.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tv_update_device"
                        style="@style/TextAppearance.Rin.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true" />
                    <TextView
                        android:id="@+id/tv_update_device_hint"
                        style="@style/TextAppearance.Rin.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/model_update_device_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Rin.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="4dp"
                android:paddingBottom="6dp"
                android:text="@string/model_update_package_section" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Rin.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:id="@+id/tv_update_local" style="@style/TextAppearance.Rin.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tv_update_remote" style="@style/TextAppearance.Rin.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                    <TextView android:id="@+id/tv_update_resolutions" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                    <TextView android:id="@+id/tv_update_lora" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textIsSelectable="true" />
                    <TextView android:id="@+id/tv_update_remote_resolutions" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                    <TextView android:id="@+id/tv_update_remote_lora" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textIsSelectable="true" />
                    <TextView android:id="@+id/tv_update_size" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Rin.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="4dp"
                android:paddingBottom="6dp"
                android:text="@string/model_update_source_section" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Rin.Card.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <Spinner
                        android:id="@+id/sp_update_source"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rin_bg_control"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp" />
                    <TextView
                        android:id="@+id/tv_update_source_used"
                        style="@style/TextAppearance.Rin.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/model_update_source_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_check"
                style="@style/Widget.Rin.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:text="@string/model_update_check_now" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_install"
                style="@style/Widget.Rin.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/model_update_install" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_ignore"
                style="@style/Widget.Rin.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/model_update_ignore_version"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_cancel"
                style="@style/Widget.Rin.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/model_update_cancel"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_model_update"
                style="@style/Widget.Rin.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_update_status"
                style="@style/TextAppearance.Rin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/model_update_idle"
                android:textIsSelectable="true" />

            <TextView style="@style/TextAppearance.Rin.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:paddingStart="4dp" android:paddingBottom="8dp" android:text="LoRA" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Rin.Card.Soft" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tv_model_center_lora_status" style="@style/TextAppearance.Rin.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在读取 LoRA 状态…" />
                    <TextView style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="管理本地 .safetensors、提示词标签、权重与最近使用记录。NPU 自测已移到高级。" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_lora" style="@style/Widget.Rin.Button.Secondary" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="打开 LoRA 管理" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/TextAppearance.Rin.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:paddingStart="4dp" android:paddingBottom="8dp" android:text="高级" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Rin.Card.Soft" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tv_model_center_advanced_status" style="@style/TextAppearance.Rin.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="运行时完整性、NPU 自测与诊断工具。" android:textIsSelectable="true" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_model_center_runtime" style="@style/Widget.Rin.Progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_runtime_check" style="@style/Widget.Rin.Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="检查运行时完整性" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_runtime_repair" style="@style/Widget.Rin.Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:text="修复 / 安装基础运行时" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_runtime_cancel" style="@style/Widget.Rin.Button.Ghost" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="暂停运行时下载" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_npu_test" style="@style/Widget.Rin.Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:text="动态 LoRA NPU 自测" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_share_npu_report" style="@style/Widget.Rin.Button.Ghost" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="分享 NPU 自测报告" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_share_lora_report" style="@style/Widget.Rin.Button.Ghost" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="分享最近 LoRA 生图诊断" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_center_share_diagnostics" style="@style/Widget.Rin.Button.Ghost" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="分享启动诊断" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
